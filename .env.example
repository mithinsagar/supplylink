# =============================================================================
# SupplyLink configuration
#
# Copy to .env and adjust. Every variable below has a working default, so an
# empty .env still runs — the defaults are the Compose topology.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Under Docker Compose the host is the service name, `postgres`. Running the
# application on the host against the Compose database, use localhost:5432.
SUPPLYLINK_DATABASE_URL=postgresql+psycopg://supplylink:supplylink_local_dev@postgres:5432/supplylink

# Credentials the postgres container initialises itself with. Keep them in step
# with SUPPLYLINK_DATABASE_URL above.
POSTGRES_USER=supplylink
POSTGRES_PASSWORD=supplylink_local_dev
POSTGRES_DB=supplylink

# Connection pool. Raise pool size only alongside the database's max_connections.
SUPPLYLINK_DB_POOL_SIZE=5
SUPPLYLINK_DB_POOL_MAX_OVERFLOW=5

# A runaway query should fail the run rather than wedging the pipeline forever.
SUPPLYLINK_DB_STATEMENT_TIMEOUT_MS=60000

# Echo every SQL statement. Useful when debugging; very noisy otherwise.
SUPPLYLINK_DB_ECHO=false

# -----------------------------------------------------------------------------
# Pipeline
# -----------------------------------------------------------------------------
# Rows per executemany chunk for staging and canonical writes. The first knob to
# tune if load throughput matters; the right value depends on row width.
SUPPLYLINK_BATCH_SIZE=1000

# Raw payloads larger than this are replaced by a marker before being stored in
# quarantine, so one pathological file cannot dominate the table.
SUPPLYLINK_MAX_QUARANTINE_PAYLOAD_BYTES=64000

# -----------------------------------------------------------------------------
# LLM quality reports
# -----------------------------------------------------------------------------
# Entirely optional. With no API key the pipeline generates a deterministic
# report from the same metrics — identical accuracy, less readable prose. An LLM
# failure never affects a data load.
SUPPLYLINK_LLM_ENABLED=true

# xai (Grok) or openai. Both speak the OpenAI-compatible chat-completions API.
SUPPLYLINK_LLM_PROVIDER=xai

# Get an xAI key at https://console.x.ai -> API Keys. Leave blank to use the
# deterministic fallback. NEVER commit a real key.
SUPPLYLINK_LLM_API_KEY=

SUPPLYLINK_LLM_MODEL=grok-4-fast

# Overrides the provider's default endpoint — for a gateway, proxy, or a locally
# hosted OpenAI-compatible model.
# SUPPLYLINK_LLM_BASE_URL=https://api.x.ai/v1

# Pinned to 0 so identical metrics yield a stable narrative. A report that reads
# differently on every run over the same data trains people to ignore it.
SUPPLYLINK_LLM_TEMPERATURE=0.0
SUPPLYLINK_LLM_MAX_OUTPUT_TOKENS=900
SUPPLYLINK_LLM_TIMEOUT_SECONDS=30
SUPPLYLINK_LLM_MAX_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Vendor API (the GlobalParts REST source)
# -----------------------------------------------------------------------------
# Read by contracts/suppliers/globalparts.yaml through ${...} substitution, so
# the contract names the credential without ever containing it.
VENDOR_API_URL=http://vendor-sim:8081
VENDOR_API_TOKEN=demo-local-token

# Fault injection in the bundled vendor simulator, for demonstrating retries.
# VENDOR_SIM_FAIL_FIRST_N=2
# VENDOR_SIM_FAIL_RATE=0.3
# VENDOR_SIM_LATENCY_MS=500
# VENDOR_SIM_REQUIRE_TOKEN=demo-local-token

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SUPPLYLINK_LOG_LEVEL=INFO
# console for humans, json for log shipping.
SUPPLYLINK_LOG_FORMAT=console
